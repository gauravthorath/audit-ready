# Copy this file to .env and fill in real values. .env is gitignored - never commit secrets.

# OpenRouter API key (https://openrouter.ai/keys) - all LLM calls route through OpenRouter (NFR-1)
OPENROUTER_API_KEY=

# Model to use via OpenRouter (override to experiment; keep a cheap default)
AUDITREADY_MODEL=openai/gpt-4o-mini

# Grader model for the eval harness's LLM-as-judge metrics (assistant/eval).
# Deliberately a different family from AUDITREADY_MODEL: a model grading its
# own answers marks them generously. Per-run override: --judge-model.
AUDITREADY_JUDGE_MODEL=google/gemini-2.5-flash
# A 404 "no endpoints matching your guardrail restrictions" means your key's
# privacy policy blocks that model's providers, not that the id is wrong:
# https://openrouter.ai/settings/privacy (gemini-2.5-pro needs it relaxed).

# --- Self-hosted / BYO LLM endpoint (CR-4) ---
# Any OpenAI-compatible endpoint works, because that is the only wire protocol
# core/llm.py speaks. Point it at your own server and no request leaves your
# network. Examples: http://ollama:11434/v1, http://vllm:8000/v1,
# http://host.docker.internal:1234/v1 (LM Studio on the host).
# AUDITREADY_LLM_BASE_URL=
# Key for that endpoint. Off OpenRouter a local server usually needs none, and
# the client sends a placeholder; set this when your gateway does want one.
# AUDITREADY_LLM_API_KEY=
# With a BYO endpoint set, AUDITREADY_MODEL becomes that server's model id
# (e.g. llama3.1:8b for Ollama, Qwen/Qwen2.5-7B-Instruct for vLLM), and the
# live cost display goes quiet - OpenRouter's pricing API does not know it.

# --- Evidence connectors (CR-3) ---
# Three live sources, three transports, one TicketSource interface. Set only the
# ones you actually want to pull from; each connector fails naming its own
# missing variable rather than failing vaguely.
#
# 1. GitHub Issues, over MCP. Token resolution order:
# AUDITREADY_GITHUB_TOKEN, then GITHUB_TOKEN / GH_TOKEN, then `gh auth token`.
# A repo-scoped classic PAT or a logged-in gh CLI is enough; read-only is fine.
AUDITREADY_GITHUB_TOKEN=
# Point at a self-hosted GitHub MCP server if you run one (CR-4: data stays put)
# AUDITREADY_GITHUB_MCP_URL=https://api.githubcopilot.com/mcp/
#
# 2. Jira Cloud, over the REST API. Not MCP: Atlassian's remote MCP server is
# OAuth-only, so it cannot run headless - see audit/jira_evidence.py.
# Site accepts a bare host or a full URL. Token (NOT your password) from
# https://id.atlassian.com/manage/api-tokens - the email must be the account
# that minted it. Read-only access to the project is enough.
#   uv run python scripts/smoke_jira.py --project AUD
# AUDITREADY_JIRA_SITE=mycompany.atlassian.net
# AUDITREADY_JIRA_EMAIL=
# AUDITREADY_JIRA_TOKEN=
#
# 3. Linear, over the GraphQL API. Also not MCP, same OAuth reason.
# Personal API key from Linear -> Settings -> Security & access -> Personal API
# keys. Sent raw, with no "Bearer" prefix (Linear is unusual here).
#   uv run python scripts/smoke_linear.py --team AUD
# AUDITREADY_LINEAR_TOKEN=

# Where the engine reads records and where the vector store lives. Override
# both together to audit a live snapshot without touching the synthetic store:
#   AUDITREADY_CORPUS_DIR=assistant/data/live AUDITREADY_PERSIST_DIR=.chroma-live
# AUDITREADY_CORPUS_DIR=assistant/data/corpus
# AUDITREADY_PERSIST_DIR=.chroma

# --- Logs and tracing ---
# text (default): `HH:MM:SS LEVEL logger event k=v ...` for a terminal.
# json: one object per line for a container or a log shipper. Every line
# carries the correlation id: the browser sends X-Request-ID, the API binds it,
# the audit thread and each model call inherit it. Find one user action with
# `grep <request_id>`; find one audit with `grep <run_id>`.
# AUDITREADY_LOG_FORMAT=text
# AUDITREADY_LOG_LEVEL=INFO

# --- Who may call (Step 40) ---
# none (default): no credential; the caller is the client address. Right for a
#   laptop, the demo and the test suite. GET /health reports the mode, so
#   "is this deployment open?" is answerable without reading this file.
# token: bearer tokens listed below. Enough for a team, CI, or an MCP client.
# oidc: the customer's identity provider. We verify a JWT; we never issue one.
# AUDITREADY_AUTH=none
# name:token[:roles], comma-separated. Roles are auditor (may spend money on
# audits and chat) and viewer (may read). Default is both.
# AUDITREADY_API_TOKENS=ci:change-me,reviewer:change-me-too:viewer
# AUDITREADY_OIDC_ISSUER=https://login.microsoftonline.com/<tenant>/v2.0
# AUDITREADY_OIDC_AUDIENCE=api://auditready
# AUDITREADY_OIDC_ROLES_CLAIM=roles
# AUDITREADY_OIDC_DEFAULT_ROLES=auditor,viewer

# --- Where a conversation lives between turns (Step 41) ---
# memory (default): a dict in this process. Does not survive a restart and is
#   not shared between workers - fine for one process, and /health says so.
# postgres: the `db` service below. A conversation survives a restart and two
#   workers see the same one. Uses AUDITREADY_PG_DSN.
# AUDITREADY_SESSION_STORE=postgres

# --- AuditReady as an MCP server (Step 42) ---
# Over stdio it is `uv run python -m api.mcp_server`, which is what Claude
# Desktop and Cursor speak; nothing to configure. Setting this to 1 also mounts
# it at /mcp for remote clients (a Microsoft 365 Copilot agent in Teams).
# Refused unless AUDITREADY_AUTH is token or oidc: an MCP endpoint without a
# credential publishes the engine to anyone who can reach the port.
# AUDITREADY_MCP_HTTP=1

# --- Rate limits and spend (per caller; the caller is the client address
# until authentication lands) ---
# Refused with a 429 and a sentence before a token is spent. 0 disables one.
# AUDITREADY_CHAT_PER_MINUTE=30
# AUDITREADY_AUDITS_PER_HOUR=6
# AUDITREADY_MAX_PAIRS_PER_RUN=400
# Daily caps in USD, UTC days, unset = unlimited. The deployment cap is the
# number whoever pays for the key cares about; the per-caller cap stops one
# user spending everyone's day. What was spent is appended to
# reports/spend.jsonl and summed at GET /spend.
# AUDITREADY_DAILY_BUDGET_USD=
# AUDITREADY_ACTOR_DAILY_BUDGET_USD=

# --- Vector store ---
# chroma (default): embedded, file-backed, zero setup - what the eval was frozen on.
# pgvector: Postgres + the vector extension - one database to self-host, the
# scale path. Same chunks, same embeddings, same similarity numbers; only the
# store changes. `docker compose up -d db` starts a local one; a hosted
# Postgres (Supabase, RDS, ...) with `CREATE EXTENSION vector` works with just
# its connection string here. Never commit a real DSN.
# AUDITREADY_VECTOR_STORE=pgvector
# AUDITREADY_PG_DSN=postgresql://auditready:auditready@localhost:5432/auditready
