  "info": {
    "description": "HTTP boundary over the AuditReady engine. Holds no business logic.",
    "title": "AuditReady API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/audit": {
      "get": {
        "operationId": "list_audits_audit_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/RunOut"
                  },
                  "title": "Response List Audits Audit Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "AuditReadyBearer": []
          }
        ],
        "summary": "List Audits"
      },
      "post": {
        "description": "Start a batch audit and return immediately with a run id.\n\nUnknown ids fail HERE, synchronously, before a thread or a token is spent -\n`run_batch` already checks them, and doing it up front turns a 500 five\nseconds later into a 404 now. The same rule covers the limits: too many\nruns, too many pairs, or a run the day's budget cannot pay for are all\nrefused here, with the estimate in the sentence.",
        "operationId": "start_audit_audit_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AuditRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StartAuditOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "AuditReadyBearer": []
          }
        ],
        "summary": "Start Audit"
      }
    },
    "/audit/{run_id}": {
      "get": {
        "operationId": "get_audit_audit__run_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "run_id",
            "required": true,
            "schema": {
              "title": "Run Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "AuditReadyBearer": []
          }
        ],
        "summary": "Get Audit"
      }
    },
    "/audit/{run_id}/events": {
      "get": {
        "description": "Progress as server-sent events, ending with the terminal status.\n\nPolling the run record every 400ms is deliberate over pushing from the\nworker thread: the worker never has to know a client exists, and a client\nthat disconnects costs nothing.",
        "operationId": "audit_events_audit__run_id__events_get",
        "parameters": [
          {
            "in": "path",
            "name": "run_id",
            "required": true,
            "schema": {
              "title": "Run Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "text/event-stream": {}
            },
            "description": "progress events, then `end`"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "AuditReadyBearer": []
          }
        ],
        "summary": "Audit Events"
      }
    },
    "/audit/{run_id}/report.md": {
      "get": {
        "operationId": "audit_markdown_audit__run_id__report_md_get",
        "parameters": [
          {
            "in": "path",
            "name": "run_id",
            "required": true,
            "schema": {
              "title": "Run Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "AuditReadyBearer": []
          }
        ],
        "summary": "Audit Markdown"
      }
    },
    "/chat": {
      "get": {
        "description": "Your conversations, newest first. Never anyone else's.",
        "operationId": "my_chats_chat_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/SessionSummaryOut"
                  },
