            "description": "Successful Response"
          }
        },
        "security": [
          {
            "AuditReadyBearer": []
          }
        ],
        "summary": "My Chats"
      },
      "post": {
        "description": "One conversational turn. The agent keeps memory across turns of a session.\n\nErrors follow the Streamlit page exactly (FR-15): a guardrail violation is\nsafe to show verbatim (400); the model being down is a 503 with a plain\nsentence; anything else is a 500 with no detail, because a stack trace in a\nbrowser is a leak, not a diagnostic. Over the rate limit or the daily\nbudget is a 429 that says so - refused before a token is spent.",
        "operationId": "chat_chat_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "AuditReadyBearer": []
          }
        ],
        "summary": "Chat"
      }
    },
    "/chat/{session_id}": {
      "delete": {
        "operationId": "end_chat_chat__session_id__delete",
        "parameters": [
          {
            "in": "path",
